{
  "expo": {
    "name": "memo",
    "slug": "memo",
    "version": "1.0.0",
    "scheme": "memo",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.memo.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a1419"
      },
      "package": "com.memo.app"
    },
    "web": {
      "bundler": "metro"
    }
  }
}